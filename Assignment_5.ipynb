   "source": [
    "import re\n",
    "\n",
    "text = input(\"Enter: \")\n",
    "\n",
    "result = re.fullmatch(r\"[a-zA-Z0-9]+\", text)\n",
    "\n",
    "print(\"Input:\", repr(text))\n",
    "print(\"Result:\", result)\n",
    "\n",
    "if result:\n",
    "    print(\"Valid\")\n",
    "else:\n",
    "    print(\"Invalid\")"
   ]
